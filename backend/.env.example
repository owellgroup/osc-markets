# Backend environment. This service is deployed on its own (port 8286).
# Copy to .env and fill in. Sensitive values only.

SERVER_PORT=8286
SERVER_ADDRESS=0.0.0.0

# Mail
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=hello@notifications.wayaspot.com

# Database
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=osc-markets
MINIO_PUBLIC_URL=

# Frontend origin (the site is a separate deployment on port 5173)
CORS_ORIGINS=http://92.4.136.176:5173,http://localhost:5173
SITE_URL=http://92.4.136.176:5173
